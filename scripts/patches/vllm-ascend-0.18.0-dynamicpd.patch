+def _clone_logprobs_tensors(
+    logprobs_tensors: LogprobsTensors | None,
+) -> LogprobsTensors | None:
+    if logprobs_tensors is None:
+        return None
+    if logprobs_tensors.logprob_token_ids.device.type == "cpu":
+        return logprobs_tensors
+    return LogprobsTensors(
+        logprob_token_ids=logprobs_tensors.logprob_token_ids.clone(),
+        logprobs=logprobs_tensors.logprobs.clone(),
+        selected_token_ranks=logprobs_tensors.selected_token_ranks.clone(),
+        cu_num_generated_tokens=logprobs_tensors.cu_num_generated_tokens,
+    )
+
+
+class AsyncNPUModelRunnerOutput(AsyncModelRunnerOutput):
+    def __init__(
+        self,
+        model_runner_output: ModelRunnerOutput,
+        sampled_token_ids: torch.Tensor,
+        logprobs_tensors: LogprobsTensors | None,
+        invalid_req_indices: list[int],
+        async_output_copy_stream: torch.npu.Stream,
+        producer_stream: torch.npu.Stream,
+        vocab_size: int,
+    ) -> None:
+        
+        self._model_runner_output = model_runner_output
+        self._invalid_req_indices = invalid_req_indices
+
+        self.device_snapshot_ready_event = torch.npu.Event()
+        self.async_copy_ready_event = torch.npu.Event()
+
+        self._sampled_token_ids = sampled_token_ids
+        self.vocab_size = vocab_size
+        self._logprobs_tensors = logprobs_tensors
+
+        self.producer_stream = producer_stream
+        self.async_output_copy_stream = async_output_copy_stream
+        with torch.npu.stream(producer_stream):
+            self.device_snapshot_ready_event.record()
+        with torch.npu.stream(async_output_copy_stream):
+            async_output_copy_stream.wait_event(
+                self.device_snapshot_ready_event)
+            self.sampled_token_ids_cpu = self._sampled_token_ids.to(
+                "cpu", non_blocking=True)
+            self._logprobs_tensors_cpu = (
+                self._logprobs_tensors.to_cpu_nonblocking()
+                if self._logprobs_tensors
+                else None
+            )
+            self.async_copy_ready_event.record()
+
+
+    def get_output(self) -> ModelRunnerOutput:
+        max_gen_len = self.sampled_token_ids_cpu.shape[-1]
+        t1 = time.perf_counter()
+        snapshot_ready = bool(self.device_snapshot_ready_event.query())
+        copy_ready = bool(self.async_copy_ready_event.query())
+        logger.info("before sync")
+        self.device_snapshot_ready_event.synchronize()
+        t2 = time.perf_counter()
+        logger.info(
+            "sync time: %.6f seconds, snapshot_ready: %s, "
+            "copy_ready_before_sync: %s, producer_stream: %s, copy_stream: %s",
+            t2 - t1,
+            snapshot_ready,
+            copy_ready,
+            self.producer_stream,
+            self.async_output_copy_stream,
+        )
+
+        del self._logprobs_tensors
+        del self._sampled_token_ids
+        if max_gen_len == 1:
+            valid_sampled_token_ids = self.sampled_token_ids_cpu.tolist()
+            for i in self._invalid_req_indices:
+                valid_sampled_token_ids[i].clear()
+            logprobs_lists = None
+            if self._logprobs_tensors_cpu is not None:
+                logprobs_lists = self._logprobs_tensors_cpu.tolists()
+        else:
+            valid_sampled_token_ids, logprobs_lists = RejectionSampler.parse_output(
+                self.sampled_token_ids_cpu,
+                self.vocab_size,
+                self._invalid_req_indices,
+                logprobs_tensors=self._logprobs_tensors_cpu,
+            )
+
+        output = self._model_runner_output
+        output.sampled_token_ids = valid_sampled_token_ids
+        output.logprobs = logprobs_lists
+        return output
+
